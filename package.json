{
    "name": "website",
    "version": "0.0.1",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lemonyte/website.git"
    },
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "deploy": "vite build && wrangler deploy",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260928.1",
        "@giscus/svelte": "^3.1.0",
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.4",
        "@types/prismjs": "^1.26.6",
        "mdsvex": "^0.12.8",
        "oxfmt": "^0.71.0",
        "prismjs": "^1.30.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-callouts": "2.1.0",
        "rehype-slug": "^6.0.0",
        "remark-github": "^12.0.0",
        "super-sitemap": "^2.0.6",
        "svelte": "^5.57.1",
        "svelte-canvas": "^2.1.0",
        "svelte-check": "^4.7.6",
        "svelte-toc": "^0.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "wrangler": "^4.147.0"
    }
}
